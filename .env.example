# Existing football booking backend. For a local backend use http://127.0.0.1:5000
FOOTBALL_BACKEND_API_URL=https://football-booking-system.onrender.com

# Supabase Postgres connection string. Keep this server-side; never put it in Vite.
# Copy it from Supabase Dashboard > Connect. Render commonly uses Session pooler.
SUPABASE_DATABASE_URL=

# Browser origins allowed to call this agent API.
AGENT_ALLOWED_ORIGINS=http://localhost:5174

PORT=5001
